{
  "name": "sinaide",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "notices": "node scripts/notices.mjs",
    "prebuild": "npm run notices",
    "dev": "vite",
    "build": "tsc -b && node --max-old-space-size=6144 node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run src",
    "test:ui": "playwright test",
    "test:desktop": "node tests/native-smoke.mjs",
    "check:native": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
